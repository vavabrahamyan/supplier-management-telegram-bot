{
  "name": "supplier-management-telegram-bot",
  "version": "0.1.0",
  "private": true,
  "description": "A Telegram bot foundation for supplier management.",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test tests/*.test.ts",
    "predev": "node scripts/check-node.cjs",
    "prebuild": "node scripts/check-node.cjs",
    "prestart": "node scripts/check-node.cjs",
    "pretypecheck": "node scripts/check-node.cjs",
    "pretest": "node scripts/check-node.cjs",
    "drive:auth": "node scripts/google-drive-auth.cjs",
    "predrive:auth": "node scripts/check-node.cjs"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "googleapis": "^190.0.0",
    "telegraf": "^4.16.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.8.3"
  }
}
